# Base URL for backend REST API (must be publicly reachable from browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time updates (must be ws:// or wss://)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Used for auth flows that need absolute redirects (future use)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
